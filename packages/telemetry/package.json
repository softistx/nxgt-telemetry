{
	"name": "@nxgt/telemetry",
	"version": "0.2.0",
	"description": "Logs and traces for a TypeScript service, with no OpenTelemetry SDK: spans over AsyncLocalStorage, W3C traceparent propagation, declared events, and a pipeline that never blocks the caller",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"telemetry",
		"observability",
		"tracing",
		"logging",
		"opentelemetry",
		"otlp",
		"traceparent",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-telemetry.git",
		"directory": "packages/telemetry"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
