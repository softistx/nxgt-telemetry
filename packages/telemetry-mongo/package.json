{
	"name": "@nxgt/telemetry-mongo",
	"version": "0.2.0",
	"description": "MongoDB for @nxgt/telemetry: an exporter that writes signals to a capped-by-TTL collection, and client spans from the driver's command monitoring",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"mongodb",
		"mongoose",
		"telemetry",
		"observability",
		"tracing",
		"logging",
		"opentelemetry",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-telemetry.git",
		"directory": "packages/telemetry-mongo"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"dependencies": {
		"@nxgt/telemetry": "workspace:^"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"mongodb": "7.6.0",
		"mongodb-memory-server-core": "11.2.0"
	},
	"peerDependencies": {
		"mongodb": ">=7.0.0 <8",
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"mongodb": {
			"optional": true
		}
	}
}
